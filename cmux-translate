#!/bin/bash
set -euo pipefail
LAUNCHER="${BASH_SOURCE[0]}"
while [[ -L "$LAUNCHER" ]]; do
  LINK_DIR="$(cd -- "$(dirname -- "$LAUNCHER")" && pwd)"
  LAUNCHER="$(readlink "$LAUNCHER")"
  [[ "$LAUNCHER" = /* ]] || LAUNCHER="$LINK_DIR/$LAUNCHER"
done
ROOT="$(cd -- "$(dirname -- "$LAUNCHER")" && pwd)"
SOURCE="$ROOT/cmux-translate-app"
DEV_TAG="${DESKTOP_TRANSLATE_DEV_TAG:-}"
GIT_DIR="$(git -C "$ROOT" rev-parse --absolute-git-dir)"
COMMON_DIR="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)"
if [[ "$GIT_DIR" != "$COMMON_DIR" && -z "$DEV_TAG" ]]; then
  printf '%s\n' 'Linked worktree requires DESKTOP_TRANSLATE_DEV_TAG; refusing release build or launch.' >&2
  exit 2
fi
if [[ -n "$DEV_TAG" ]]; then
  if [[ ! "$DEV_TAG" =~ ^[A-Za-z0-9-]+$ ]]; then
    printf '%s\n' 'DESKTOP_TRANSLATE_DEV_TAG must match [A-Za-z0-9-]+.' >&2
    exit 2
  fi
  export XDG_DATA_HOME="$ROOT/.dev/data"
  export XDG_CONFIG_HOME="$ROOT/.dev/config"
  APP_NAME="Desktop Translate DEV.app"
  BUNDLE_ID="local.cmux.translate.dev.$DEV_TAG"
  BASE="$ROOT/.dev/build"
  for isolated in "$ROOT/.dev" "$ROOT/.dev/data" "$ROOT/.dev/config" "$ROOT/.dev/build"; do
    if [[ -L "$isolated" ]]; then
      printf 'Refusing symlinked development path: %s\n' "$isolated" >&2
      exit 2
    fi
  done
else
  BASE="${XDG_DATA_HOME:-$HOME/.local/share}/cmux-translate"
  APP_NAME="CMux Translate.app"
  BUNDLE_ID="local.cmux.translate"
fi
APP="$BASE/$APP_NAME"
EXEC="$APP/Contents/MacOS/cmux-translate"
COMMAND="${1:-start}"
# Per-run, explicit authorization to activate the NEW public fixture this run launches (never the product overlay).
# Only the flag enables it; an ambient environment value is discarded.
unset DESKTOP_TRANSLATE_AUTHORIZE_FIXTURE_ACTIVATION
if [[ "${2:-}" == "--authorize-fixture-activation" ]]; then
  case "$COMMAND" in
    smoke|pi-smoke|glyph-smoke|glyph-pi-smoke|permission-probe) export DESKTOP_TRANSLATE_AUTHORIZE_FIXTURE_ACTIVATION=1 ;;
    *) printf 'Unknown option for %s: %s\n' "$COMMAND" "$2" >&2; exit 2 ;;
  esac
elif [[ $# -gt 1 ]]; then
  printf 'Unknown argument: %s\n' "$2" >&2; exit 2
fi
case "$COMMAND" in
  help|--help|-h)
    printf '%s\n' 'cmux-translate [start|run|build|smoke|pi-smoke|glyph-smoke|glyph-pi-smoke|shortcut-smoke|permission-probe|child-permission-report|capture]' 'start: build if needed and run in menu bar (default)' 'run: foreground app; build: compile only' 'smoke: real OCR translate over the independent public fixture window' 'pi-smoke: real configured pi model translation of public sample (cloud request)' 'glyph-smoke: one capture over the glyph fixture with the selected backend; OCR/mask edge errors vs manifest (needs fixtures/build-glyph-fixture.sh)' 'glyph-pi-smoke: same with pi' 'shortcut-smoke: exercise configurable hotkey UI with isolated temporary settings' 'permission-probe: one SCK shot of the public fixture (no OCR, nothing saved)' 'child-permission-report: disclaimed child must not inherit SR/AX' 'capture: inspect frontmost window metadata, without printing its content' 'Settings: menu bar 译 → 翻译模式与模型… / 设置快捷键…; Escape returns to target.' 'Requires macOS 15+, Xcode Command Line Tools; pi optional.' 'Worktree dev builds require DESKTOP_TRANSLATE_DEV_TAG matching [A-Za-z0-9-]+; outputs stay under .dev/.'
    printf '%s\n' 'request-screen-recording: preflight once and request once if needed; metadata only, no capture; exit 0 means command completed, not permission granted'
    exit 0 ;;
  start|run|build|smoke|pi-smoke|glyph-smoke|glyph-pi-smoke|terminal-fixture-smoke|terminal-fixture-pi-smoke|shortcut-smoke|permission-probe|request-screen-recording|child-permission-report|capture) ;;
  *) printf 'Unknown command: %s (see: cmux-translate help)\n' "$COMMAND" >&2; exit 2 ;;
esac
mkdir -p "$BASE"
NEEDS_BUILD=false
if [[ ! -x "$EXEC" ]]; then
  NEEDS_BUILD=true
elif ! CACHED_BUNDLE_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist" 2>/dev/null)" || [[ "$CACHED_BUNDLE_ID" != "$BUNDLE_ID" ]]; then
  # Dev tags share a build path, so timestamps alone cannot validate the cache.
  NEEDS_BUILD=true
else
  for file in "$SOURCE"/*.swift "$SOURCE"/*.mjs "$SOURCE/Info.plist" "$ROOT/cmux-translate" "$ROOT/fixtures/GlyphSceneManifest.swift"; do
    if [[ "$file" -nt "$EXEC" ]]; then NEEDS_BUILD=true; break; fi
  done
fi
if $NEEDS_BUILD; then
  LOCK="$BASE/build.lock"
  if ! mkdir "$LOCK" 2>/dev/null; then
    printf 'Another build is running; retry when it finishes. If interrupted, remove %s.\n' "$LOCK" >&2
    exit 1
  fi
  STAGE="$(mktemp -d "$BASE/build.XXXXXX")"
  trap 'rm -rf "$STAGE"; rmdir "$LOCK"' EXIT
  mkdir -p "$STAGE/$APP_NAME/Contents/MacOS"
  xcrun swiftc -O -parse-as-library -target arm64-apple-macos15.0 \
    "$SOURCE"/*.swift "$ROOT/fixtures/GlyphSceneManifest.swift" -o "$STAGE/$APP_NAME/Contents/MacOS/cmux-translate" \
    -framework AppKit -framework SwiftUI -framework Translation -framework Carbon \
    -framework ScreenCaptureKit -framework Vision
  cp "$SOURCE/Info.plist" "$STAGE/$APP_NAME/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $BUNDLE_ID" "$STAGE/$APP_NAME/Contents/Info.plist"
  # Release and dev builds share one visible display name; only the bundle identifier separates them.
  mkdir -p "$STAGE/$APP_NAME/Contents/Resources"
  cp "$SOURCE/pi-translation-extension.mjs" "$STAGE/$APP_NAME/Contents/Resources/"
  codesign --force --sign "${DESKTOP_TRANSLATE_SIGN_IDENTITY:--}" "$STAGE/$APP_NAME" >&2
  if [[ -e "$APP" ]]; then rm -rf "$APP"; fi
  mv "$STAGE/$APP_NAME" "$APP"
  rmdir "$STAGE" "$LOCK"
  trap - EXIT
fi
# Diagnostic commands run the app as its own LaunchServices process (not a child of this terminal, so the terminal is
# neither the responsible process for Screen Recording nor a parent that is waited on or re-activated). `-g` keeps
# open(1) from activating anything; JSON is returned through private files. The request-only command uses
# commandCompleted (not a permission verdict); other diagnostics use ok. Pi selectors are forwarded explicitly.
run_via_launchservices() {
  local out err open_rc=0 ok result_key="${2:-ok}"
  out="$(mktemp "$BASE/smoke-out.XXXXXX")"; err="$(mktemp "$BASE/smoke-err.XXXXXX")"
  trap 'rm -f "$out" "$err"' EXIT
  chmod 600 "$out" "$err"
  # Paths and non-secret selectors only; API keys are never put on argv (pi reads its auth files under PI_CODING_AGENT_DIR/HOME).
  local envargs=()
  local name
  for name in CMUX_TRANSLATE_PI_MODEL CMUX_TRANSLATE_PI_EXECUTABLE CMUX_TRANSLATE_GLYPH_SCENE DESKTOP_TRANSLATE_FIXTURE_APP DESKTOP_TRANSLATE_GLYPH_FIXTURE_APP DESKTOP_TRANSLATE_AUTHORIZE_FIXTURE_ACTIVATION DESKTOP_TRANSLATE_TERMINAL_TOKEN DESKTOP_TRANSLATE_TERMINAL_HANDOFF DESKTOP_TRANSLATE_TERMINAL_STATE_ROOT DESKTOP_TRANSLATE_TERMINAL_FIXTURE_AUTHORIZED XDG_DATA_HOME XDG_CONFIG_HOME PATH HOME PI_CODING_AGENT_DIR; do
    if [[ -n "${!name:-}" ]]; then envargs+=(--env "$name=${!name}"); fi
  done
  /usr/bin/open -g -n -W --stdout "$out" --stderr "$err" "${envargs[@]}" "$APP" --args "$1" || open_rc=$?
  cat "$err" >&2
  if [[ ! -s "$out" ]]; then
    printf '%s\n' "LaunchServices 启动失败或应用未输出结果（open 退出码 $open_rc）。" >&2
    exit "$(( open_rc != 0 ? open_rc : 1 ))"
  fi
  cat "$out"
  # Read completion separately from any permission API return value.
  if ok="$(/usr/bin/plutil -extract "$result_key" raw -o - -- "$out" 2>/dev/null)" && [[ "$ok" == "true" ]]; then exit 0; fi
  exit 1
}
case "$COMMAND" in
  build) printf 'Built %s\n' "$APP" ;;
  run) exec "$EXEC" ;;
  smoke) run_via_launchservices --smoke ;;
  pi-smoke) run_via_launchservices --pi-smoke ;;
  glyph-smoke) run_via_launchservices --glyph-smoke ;;
  glyph-pi-smoke) run_via_launchservices --glyph-pi-smoke ;;
  terminal-fixture-smoke) run_via_launchservices --terminal-fixture-smoke ;;
  terminal-fixture-pi-smoke) run_via_launchservices --terminal-fixture-pi-smoke ;;
  shortcut-smoke) exec "$EXEC" --shortcut-smoke ;;
  permission-probe) run_via_launchservices --permission-probe ;;
  request-screen-recording) run_via_launchservices --request-screen-recording commandCompleted ;;
  child-permission-report) exec "$EXEC" --child-permission-report ;;
  capture) exec "$EXEC" --capture ;;
  start)
    nohup "$EXEC" >> "$BASE/app.log" 2>&1 < /dev/null &
    printf 'CMux Translate launched (PID %s). Configure mode/model/shortcut in menu bar 译.\nLog: %s/app.log\n' "$!" "$BASE"
    ;;
esac
