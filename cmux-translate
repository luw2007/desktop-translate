#!/bin/bash
set -euo pipefail
LAUNCHER="${BASH_SOURCE[0]}"
while [[ -L "$LAUNCHER" ]]; do
  LINK_DIR="$(cd -- "$(dirname -- "$LAUNCHER")" && pwd)"
  LAUNCHER="$(readlink "$LAUNCHER")"
  [[ "$LAUNCHER" = /* ]] || LAUNCHER="$LINK_DIR/$LAUNCHER"
done
ROOT="$(cd -- "$(dirname -- "$LAUNCHER")" && pwd)"
SOURCE="$ROOT/cmux-translate-app"
DEV_TAG="${DESKTOP_TRANSLATE_DEV_TAG:-}"
GIT_DIR="$(git -C "$ROOT" rev-parse --absolute-git-dir)"
COMMON_DIR="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir)"
if [[ "$GIT_DIR" != "$COMMON_DIR" && -z "$DEV_TAG" ]]; then
  printf '%s\n' 'Linked worktree requires DESKTOP_TRANSLATE_DEV_TAG; refusing release build or launch.' >&2
  exit 2
fi
if [[ -n "$DEV_TAG" ]]; then
  if [[ ! "$DEV_TAG" =~ ^[A-Za-z0-9-]+$ ]]; then
    printf '%s\n' 'DESKTOP_TRANSLATE_DEV_TAG must match [A-Za-z0-9-]+.' >&2
    exit 2
  fi
  export XDG_DATA_HOME="$ROOT/.dev/data"
  export XDG_CONFIG_HOME="$ROOT/.dev/config"
  APP_NAME="Desktop Translate DEV.app"
  BUNDLE_ID="local.cmux.translate.dev.$DEV_TAG"
  BASE="$ROOT/.dev/build"
  for isolated in "$ROOT/.dev" "$ROOT/.dev/data" "$ROOT/.dev/config" "$ROOT/.dev/build"; do
    if [[ -L "$isolated" ]]; then
      printf 'Refusing symlinked development path: %s\n' "$isolated" >&2
      exit 2
    fi
  done
else
  BASE="${XDG_DATA_HOME:-$HOME/.local/share}/cmux-translate"
  APP_NAME="CMux Translate.app"
  BUNDLE_ID="local.cmux.translate"
fi
APP="$BASE/$APP_NAME"
EXEC="$APP/Contents/MacOS/cmux-translate"
COMMAND="${1:-start}"
case "$COMMAND" in
  help|--help|-h)
    printf '%s\n' 'cmux-translate [start|run|build|smoke|pi-smoke|shortcut-smoke|permission-probe|child-permission-report|capture]' 'start: build if needed and run in menu bar (default)' 'run: foreground app; build: compile only' 'smoke: real OCR translate over the independent public fixture window' 'pi-smoke: real configured pi model translation of public sample (cloud request)' 'shortcut-smoke: exercise configurable hotkey UI with isolated temporary settings' 'permission-probe: one SCK shot of the public fixture (no OCR, nothing saved)' 'child-permission-report: disclaimed child must not inherit SR/AX' 'capture: inspect frontmost window metadata, without printing its content' 'Settings: menu bar 译 → 翻译模式与模型… / 设置快捷键…; Escape returns to target.' 'Requires macOS 15+, Xcode Command Line Tools; pi optional.' 'Worktree dev builds require DESKTOP_TRANSLATE_DEV_TAG matching [A-Za-z0-9-]+; outputs stay under .dev/.'
    exit 0 ;;
  start|run|build|smoke|pi-smoke|shortcut-smoke|permission-probe|child-permission-report|capture) ;;
  *) printf 'Unknown command: %s (see: cmux-translate help)\n' "$COMMAND" >&2; exit 2 ;;
esac
mkdir -p "$BASE"
NEEDS_BUILD=false
if [[ ! -x "$EXEC" ]]; then
  NEEDS_BUILD=true
elif ! CACHED_BUNDLE_ID="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$APP/Contents/Info.plist" 2>/dev/null)" || [[ "$CACHED_BUNDLE_ID" != "$BUNDLE_ID" ]]; then
  # Dev tags share a build path, so timestamps alone cannot validate the cache.
  NEEDS_BUILD=true
else
  for file in "$SOURCE"/*.swift "$SOURCE"/*.mjs "$SOURCE/Info.plist" "$ROOT/cmux-translate"; do
    if [[ "$file" -nt "$EXEC" ]]; then NEEDS_BUILD=true; break; fi
  done
fi
if $NEEDS_BUILD; then
  LOCK="$BASE/build.lock"
  if ! mkdir "$LOCK" 2>/dev/null; then
    printf 'Another build is running; retry when it finishes. If interrupted, remove %s.\n' "$LOCK" >&2
    exit 1
  fi
  STAGE="$(mktemp -d "$BASE/build.XXXXXX")"
  trap 'rm -rf "$STAGE"; rmdir "$LOCK"' EXIT
  mkdir -p "$STAGE/$APP_NAME/Contents/MacOS"
  xcrun swiftc -O -parse-as-library -target arm64-apple-macos15.0 \
    "$SOURCE"/*.swift -o "$STAGE/$APP_NAME/Contents/MacOS/cmux-translate" \
    -framework AppKit -framework SwiftUI -framework Translation -framework Carbon \
    -framework ScreenCaptureKit -framework Vision
  cp "$SOURCE/Info.plist" "$STAGE/$APP_NAME/Contents/Info.plist"
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $BUNDLE_ID" "$STAGE/$APP_NAME/Contents/Info.plist"
  if [[ -n "$DEV_TAG" ]]; then
    /usr/libexec/PlistBuddy -c 'Set :CFBundleName Desktop Translate DEV' "$STAGE/$APP_NAME/Contents/Info.plist"
    /usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName Desktop Translate DEV' "$STAGE/$APP_NAME/Contents/Info.plist"
  fi
  mkdir -p "$STAGE/$APP_NAME/Contents/Resources"
  cp "$SOURCE/pi-translation-extension.mjs" "$STAGE/$APP_NAME/Contents/Resources/"
  codesign --force --sign "${DESKTOP_TRANSLATE_SIGN_IDENTITY:--}" "$STAGE/$APP_NAME" >&2
  if [[ -e "$APP" ]]; then rm -rf "$APP"; fi
  mv "$STAGE/$APP_NAME" "$APP"
  rmdir "$STAGE" "$LOCK"
  trap - EXIT
fi
case "$COMMAND" in
  build) printf 'Built %s\n' "$APP" ;;
  run) exec "$EXEC" ;;
  smoke) exec "$EXEC" --smoke ;;
  pi-smoke) exec "$EXEC" --pi-smoke ;;
  shortcut-smoke) exec "$EXEC" --shortcut-smoke ;;
  permission-probe) exec "$EXEC" --permission-probe ;;
  child-permission-report) exec "$EXEC" --child-permission-report ;;
  capture) exec "$EXEC" --capture ;;
  start)
    nohup "$EXEC" >> "$BASE/app.log" 2>&1 < /dev/null &
    printf 'CMux Translate launched (PID %s). Configure mode/model/shortcut in menu bar 译.\nLog: %s/app.log\n' "$!" "$BASE"
    ;;
esac
